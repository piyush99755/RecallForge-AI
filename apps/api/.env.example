# Application Environment ("development" | "production")
APP_NAME=RecallForge AI API
APP_ENV=development
# Operating Mode ("personal" | "demo")
APP_MODE=personal
DEBUG=false

# Database (Supabase PostgreSQL / pgvector connection string)
DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Gemini AI Models
GEMINI_API_KEY=your-gemini-api-key
EMBEDDING_MODEL=gemini-embedding-001
RERANKER_MODEL=gemini-3.6-flash

# Personal API Auth Gate (used when APP_MODE=personal)
# Required in production (APP_ENV=production). Generate a random secret token (e.g. openssl rand -hex 32).
API_ACCESS_TOKEN=your-personal-access-token

# Public Employer Demo Session Signing Secret (used ONLY when APP_MODE=demo; server-side only, never returned to browser)
DEMO_SESSION_SIGNING_SECRET=your-dedicated-demo-signing-secret
# Explicit confirmation flag required only when running `python -m app.db.seed_demo --reset`
DEMO_RESET_ALLOWED=false

# Comma-separated allowed CORS origins (no wildcard '*' allowed with credentials)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Document Storage Backend ("local" | "supabase")
STORAGE_BACKEND=local
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=documents
